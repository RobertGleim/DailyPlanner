# Local server port (only used by `npm start`, not on Vercel)
PORT=4000

# Storage driver: "local" (files on disk) or "supabase" (Postgres + Storage).
# Leave unset locally to default to "local". Vercel deployments default to
# "supabase" automatically (no writable filesystem there), but you can still
# set it explicitly below.
STORAGE_DRIVER=local

# Required when STORAGE_DRIVER=supabase (always required in the Vercel
# project's environment variables). Get these from your Supabase project's
# Settings -> API page. Use the service_role key (server-side only, never
# expose it to the browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_LIBRARY_BUCKET=library
