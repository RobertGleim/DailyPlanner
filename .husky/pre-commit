#!/usr/bin/env sh

changed=$(git diff --cached --name-only)

touches_root_claude_md=$(echo "$changed" | grep -x 'CLAUDE.md' || true)

missing=""
for dir in server public api supabase scripts; do
  touches_dir=$(echo "$changed" | grep -E "^${dir}/" || true)
  if [ -n "$touches_dir" ]; then
    touches_dir_claude_md=$(echo "$changed" | grep -x "${dir}/CLAUDE.md" || true)
    if [ -z "$touches_dir_claude_md" ] && [ -z "$touches_root_claude_md" ]; then
      missing="$missing $dir/"
    fi
  fi
done

if [ -n "$missing" ]; then
  echo ""
  echo "This commit changes files under:$missing"
  echo "but doesn't update that directory's own CLAUDE.md (or the root CLAUDE.md)."
  echo ""
  echo "Each top-level directory has a CLAUDE.md kept current with its own"
  echo "architecture/conventions for future Claude Code sessions (and humans)."
  echo "If this change is user-facing or structural, update the relevant"
  echo "CLAUDE.md before committing."
  echo ""
  echo "If this commit genuinely doesn't need a doc update, bypass with:"
  echo "  git commit --no-verify"
  echo ""
  exit 1
fi

exit 0
